{
  "pinnedDep": {
    "name": "@elvatis_com/aahp",
    "location": "devDependencies",
    "allowRange": false
  },
  "forbiddenPatterns": [
    {
      "id": "em-dash",
      "pattern": "\\u2014",
      "message": "em dash (U+2014) is banned; use a hyphen",
      "include": [
        "*.md",
        "*.mjs",
        "*.js",
        "*.json",
        "*.sh",
        "*.bash",
        "*.bats",
        "*.yml",
        "*.yaml",
        "*.txt",
        "*.example"
      ]
    },
    {
      "id": "bare-sibling-version",
      "pattern": "conduit-bridge\\s+(?!v)\\d+\\.\\d+\\.\\d+",
      "flags": "g",
      "include": [
        "*.md"
      ],
      "message": "write the sibling repo version as vX.Y.Z so version-sync cannot count it"
    }
  ],
  "versionSites": [
    {
      "file": "README.md",
      "minOccurrences": 4,
      "boundary": true,
      "note": "version header, 2 install snippets, packaging step (the vN.N.N changelog heading is not boundary-matched)"
    },
    {
      "file": "CHANGELOG.md",
      "minOccurrences": 1,
      "boundary": true,
      "note": "release section heading"
    },
    {
      "file": ".ai/handoff/STATUS.md",
      "minOccurrences": 1,
      "boundary": true,
      "note": "Current Version header"
    },
    {
      "file": ".ai/handoff/DASHBOARD.md",
      "minOccurrences": 2,
      "boundary": true,
      "note": "Version row and packaged vsix filename"
    },
    {
      "file": "package-lock.json",
      "minOccurrences": 2,
      "boundary": true,
      "note": "root version and packages[\"\"] version; npm version updates both"
    },
    {
      "file": "CLAUDE.md",
      "minOccurrences": 1,
      "boundary": true,
      "note": "the \"Current version\" line, which was stale at 0.9.0 while package.json read 0.10.1"
    }
  ],
  "verifyWorkflow": {
    "enforce": true
  },
  "docLinks": {
    "include": [
      "README.md",
      "CLAUDE.md",
      "CONTRIBUTING.md",
      "docs/*.md",
      ".ai/handoff/*.md"
    ]
  }
}
